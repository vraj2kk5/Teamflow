# TeamFlow Root Environment Configuration Example
# See server/.env.example and client/.env.example for component-specific configurations

# Server Configuration
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamflow?schema=public
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Media Storage Driver (local | s3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
FILE_TOKEN_SECRET=token-secret-for-signed-media-links-min-32-chars

# S3 Compatible Storage (optional when STORAGE_DRIVER=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=teamflow-media
S3_ACCESS_KEY_ID=your-s3-access-key
S3_SECRET_ACCESS_KEY=your-s3-secret-key

# Media Size Limits in Megabytes
MAX_AUDIO_MB=25
MAX_VIDEO_MB=100
MAX_IMAGE_MB=5

# Client Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000/api
