# Server Environment Variables
PORT=5000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/teamflow?schema=public
JWT_SECRET=super-secret-jwt-key-replace-in-production-min-32-chars
JWT_EXPIRES_IN=7d
CLIENT_ORIGIN=http://localhost:3000
COOKIE_SAMESITE=lax
COOKIE_SECURE=false

# Storage Driver (local | s3)
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=uploads
FILE_TOKEN_SECRET=token-secret-for-signed-media-links-min-32-chars

# S3 Configuration (required if STORAGE_DRIVER=s3)
S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
S3_REGION=auto
S3_BUCKET=teamflow-media
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Upload Limits in Megabytes
MAX_AUDIO_MB=25
MAX_VIDEO_MB=100
MAX_IMAGE_MB=5


# SMTP Email Delivery (Gmail, Outlook, SendGrid, etc.)
# If configured, real emails will be delivered directly to the inbox.
# If omitted or empty, reset links & notifications are safely logged to your backend console.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="TeamFlow Support <noreply@teamflow.local>"

# Resend API Delivery (Recommended - No app passwords needed, 1-click free signup)
# Sign up at https://resend.com, generate an API key (re_...), and paste it here:
RESEND_API_KEY=
EMAIL_FROM=TeamFlow <onboarding@resend.dev>
